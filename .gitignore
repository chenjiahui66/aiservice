backend/data/
backend/logs/
*.log
/upload/
uploads/
deploy/certs/
deploy/**/*.key
deploy/**/*.pem

# ---------- 数据库导出 ----------
sql/*.sql.bak
sql/dump/

# ---------- 部署产物（构建出来的包，不入库） ----------
