{
  "name": "neighbor-service-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "邻小来 · Taro 4 微信小程序端（服务者工作台 + 客户扫码预约）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "scripts": {
    "predev:weapp": "node ../tests/check-miniapp-config.cjs",
    "dev:weapp": "taro build --type weapp --watch",
    "prebuild:weapp": "node ../tests/check-dist-clean.cjs && node ../tests/check-miniapp-config.cjs",
    "build:weapp": "taro build --type weapp && node ../tests/check-miniapp-dist.cjs && node ../tests/check-miniapp-runtime.cjs",
    "build:h5": "taro build --type h5"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@tarojs/webpack5-runner": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-html": "4.3.0",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.3.0",
    "sass": "^1.105.1",
    "typescript": "^5.4.5"
  }
}
