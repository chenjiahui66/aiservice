# ============================================================
# 环境变量 —— 本文件可提交，但**不包含任何真实密钥**
#
# 使用：
#     copy deploy\.env.example deploy\.env    # 然后填入真实值
# deploy\.env 已被 .gitignore 忽略，不会进入仓库。
# ============================================================

# ---------- 数据库 ----------
# ⚠️ DB_HOST / DB_PORT 不用填：compose 里已固定为 mysql:3306（容器网络内的服务名），
#    填 127.0.0.1 会连到自己而不是数据库容器。
DB_NAME=neighborhood
# 建议使用最小权限账号，不要在生产用 root
DB_USERNAME=
DB_PASSWORD=

# MySQL root 密码：仅用于容器初始化与健康检查，应用本身不使用。
# deploy.sh 会在首次部署时自动生成并回填到 deploy/.env。
MYSQL_ROOT_PASSWORD=

# ---------- JWT（必填）----------
# 两个密钥必须不同，且均不少于 32 字节。
# 生成： openssl rand -base64 48
#
# ⚠️ 不要在任何脚本里写兜底默认值。
#    application-prod.yml 依赖 ${JWT_PROVIDER_SECRET:?} 做启动失败校验，
#    若脚本先塞一个写死的密钥，这道校验就会失效，
#    生产环境会悄悄用上公开可查的签名密钥。
JWT_PROVIDER_SECRET=
JWT_ADMIN_SECRET=
JWT_PROVIDER_EXPIRE_MINUTES=10080
JWT_ADMIN_EXPIRE_MINUTES=480

# ---------- 微信小程序 ----------
# 留空则小程序码自动走「开发降级」模式（生成带水印的占位二维码，不可对外使用）
# 生产环境未配置会导致启动失败，这是刻意设计
WX_APP_ID=
WX_APP_SECRET=
# AUTO / REAL / DEV
WX_CODE_MODE=AUTO
WX_SCENE_PAGE=pages/provider/index
WX_ACCESS_TOKEN_TTL=6600

# ---------- 存储 ----------
QR_DIR=/data/qr
# 对外可访问的落地页地址，用于展示推广链接。
# compose 中已固定为 https://community.aindgc.com，此处仅作记录。
PUBLIC_BASE_URL=https://community.aindgc.com

# ---------- 网关接入 ----------
# 同机 aindgc 的 nginx 容器所在的 docker 网络名。
# nb-admin 必须加入该网络，外部网关才能按容器名反代进来；
# 填错会导致网关侧 502（host not found）。
#
# 查法（在服务器上执行）：
#   docker network ls
#   docker inspect <aindgc-nginx 容器名> --format '{{json .NetworkSettings.Networks}}'
#
# 留空则回退为默认值 aitools-net。
GATEWAY_NETWORK=

# ---------- 管理员账号（必填）----------
# 首次启动时应用会据此创建管理员；账号已存在则不做任何修改（幂等）。
# 口令只存在于服务器本机的 deploy\.env，不会进入任何提交文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ENABLED=true

# ---------- 服务 ----------
# ⚠️ SERVER_PORT / SPRING_PROFILES_ACTIVE / LOG_LEVEL / SQL_INIT_MODE
#    在 compose 的 environment 段已固定（prod / 8080），此处仅为本地开发参考，
#    生产部署时改这里不生效。
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# SQL_INIT_MODE=always 可让应用启动时自动执行 schema.sql / seed.sql
SQL_INIT_MODE=never
