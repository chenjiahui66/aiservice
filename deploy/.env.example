# ============================================================
# 环境变量示例 —— 复制为 .env 后填写真实值
# ⚠️ 本文件已进入 Git，务必不要填入任何真实密钥
# ============================================================

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neighborhood
# 建议使用最小权限账号，不要在生产用 root
DB_USERNAME=app_user
DB_PASSWORD=

# ---------- JWT ----------
# 两个密钥必须不同，且均不少于 32 字节；用 openssl rand -base64 48 生成
JWT_PROVIDER_SECRET=
JWT_ADMIN_SECRET=
JWT_PROVIDER_EXPIRE_MINUTES=10080
JWT_ADMIN_EXPIRE_MINUTES=480

# ---------- 微信小程序 ----------
# 留空则小程序码自动走「开发降级」模式（生成带水印的占位二维码，不可对外使用）
# 生产环境未配置会导致启动失败，这是刻意设计
WX_APP_ID=
WX_APP_SECRET=
# AUTO / REAL / DEV
WX_CODE_MODE=AUTO
WX_SCENE_PAGE=pages/provider/index
WX_ACCESS_TOKEN_TTL=6600

# ---------- 存储 ----------
QR_DIR=./data/qr
# 对外可访问的落地页地址，用于展示推广链接（不填则用 localhost 提示）
PUBLIC_BASE_URL=

# ---------- 开发环境首次创建管理员 ----------
# 仅 dev profile 生效，密码不会写入任何提交文件
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# SQL_INIT_MODE=always 可让应用启动时自动执行 schema.sql / seed.sql
SQL_INIT_MODE=never